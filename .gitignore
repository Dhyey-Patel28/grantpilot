MANIFEST
.installed.cfg

# Logs / local databases
*.log
db.sqlite3
db.sqlite3-journal

# Node dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Next / JS build outputs
.next/
frontend/.next/
backend/.next/
out/
coverage/

# Secrets / local config
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

backend/.env
backend/.env.local
backend/.env.*.local

frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/.env.*.local

# Keep safe public config files
!frontend/.env.example
!frontend/.env.production
!backend/.env.example

# Local secret folders
wxo-keys/

# GrantPilot cache strategy
# Keep clean fallback/cache outputs.
# Ignore noisy raw scraped API/HTML/browser captures.
cache/raw/

!cache/normalized/
!cache/normalized/**
!cache/metadata/
!cache/metadata/**
!cache/registry/
!cache/registry/**

# Runtime output
# Keep sample generated packets, ignore videos/temp/generated clutter.
outputs/*
!outputs/packets/
!outputs/packets/*.md

recordings/
tmp/
.temp/

# Backend runtime traces/state
# The frontend has sanitized demo JSON; backend runtime traces can contain local prompt/API details.
backend/data/

# Large local media / recordings
*.mp4
*.mov
*.webm
*.mkv

# Local archives and backups
*.zip
*.tar
*.tar.gz
grantPilot-backup-*/
grantPilot-broken-merge-*/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Cursor
.cursorignore
.cursorindexingignore

# Recording tools and scripts
recording_tools/
scripts/
scripts/cursorful-*
scripts/demo-*
scripts/record-demo*
scripts/render-demo-video.mjs
scripts/start-chrome-for-cursorful.ps1